# Copy to .env and fill in. .env is gitignored — never paste keys into chat.

# 1 = invented demo data (default), 0 = your real folders
JARVIS_DEMO=1
# Real folders to index when JARVIS_DEMO=0, separated by ;
JARVIS_FOLDERS=C:\Users\abara\Documents\JARVIS Vault

# Conversation model — https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
# Everyday chat goes to a cheaper model; research, drafting, planning, attachments and long
# questions stay on JARVIS_MODEL. JARVIS_ROUTING=off sends every turn to JARVIS_MODEL.
JARVIS_FAST_MODEL=claude-sonnet-5
JARVIS_ROUTING=auto
# low is quick for voice; medium/high think harder
JARVIS_EFFORT=low
# Web search is paid: ask (confirm each time), auto, or off
JARVIS_WEB_SEARCH=ask
# Estimated spend per day before JARVIS warns you (USD)
JARVIS_DAILY_BUDGET=2
# Evening check-in hour (UK), or off
JARVIS_CHECKIN_HOUR=19

# Voice in + out — https://elevenlabs.io → Profile → API keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gmail (read-only) + Google Calendar — OAuth "Desktop app" client from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram: talk to JARVIS from your phone. Token from @BotFather (see README)
TELEGRAM_BOT_TOKEN=

# Private GitHub repo that backs up the Obsidian vault (empty = no backup)
JARVIS_BACKUP_REMOTE=
