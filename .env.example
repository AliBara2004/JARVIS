# Copy to .env and fill in. .env is gitignored — never paste keys into chat.

# 1 = invented demo data (default), 0 = your real folders
JARVIS_DEMO=1
# Real folders to index when JARVIS_DEMO=0, separated by ;
JARVIS_FOLDERS=C:\Users\abara\Documents\JARVIS Vault

# Conversation model — https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-opus-5
# low is quick for voice; medium/high think harder
JARVIS_EFFORT=low
# Web search is paid: ask (confirm each time), auto, or off
JARVIS_WEB_SEARCH=ask

# Voice in + out — https://elevenlabs.io → Profile → API keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gmail (read-only) + Google Calendar — OAuth "Desktop app" client from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
